#!/usr/bin/env zsh

alias g='git'

alias gs='git status'
alias gss='git show'
alias gd='git diff'
alias gdh='git diff HEAD'
alias gdo='git diff "origin/$(git branch --show-current)"'
alias gl='git log'
alias gll='git log --oneline'

alias gb='git branch'
alias gba='git branch --all'

alias ga='git add'

alias gcc='git checkout'

alias gc='git commit'
alias gca='GIT_COMMITTER_DATE="$(git log -1 --format=%aD)" git commit --amend'
alias gcane='gca --no-edit'

alias gp='git pull'
function gpr {
  local remote branch
  if [ "$#" -eq 0 ]; then
    remote='upstream'
    branch="$(git branch --show-current)"
  else
    remote=$1
    branch=$2
  fi
  git pull --rebase "$remote" "$branch"
}

alias gpp='git push'
alias gppf='git push --force'
function gppa {
  for remote in $(git remote); do
    echo "pushing to $remote..."
    git push "$remote" "$(git branch --show-current)" "$@"
  done
}
alias gppfa='gppa --force'

alias gr='git rebase --committer-date-is-author-date'
alias gra='git rebase --abort'
alias grc='git rebase --continue'
alias gri='gr --interactive'

alias grr='git remote'
alias grrv='git remote --verbose'

function get_git_url {
  local remote
  if [ "$#" -eq 0 ]; then
    remote='origin'
  else
    remote=$1
  fi

  git remote --verbose |
    grep "$remote" |
    tr -s '[:space:]' ' ' |
    cut -d ' ' -f 2 |
    uniq |
    sed 's/\.git$//' |
    sed 's/git@//' |
    sed 's/:/\//'
}

function gh {
  local url branch git_root repo_path
  url=$(get_git_url "$@")
  branch=$(git branch --show-current)
  git_root=$(git rev-parse --show-toplevel)
  repo_path="${PWD#"$git_root"}"
  [ -n "$url" ] && open_url "https://$url/tree/$branch$repo_path"
}

function ghd {
  local source_remote target_remote source_branch target_branch source_url target_url
  source_remote='origin'
  target_remote='upstream'
  source_branch=$(git branch --show-current)
  if [ "$#" -eq 1 ]; then
    target_branch=$1
  else
    target_branch="$source_branch"
  fi
  source_url=$(get_git_url $source_remote)
  target_url=$(get_git_url $target_remote)
  head="$(echo "$source_url" | cut -d '/' -f 2):$source_branch"
  [ -n "$target_url" ] && open_url "https://$target_url/compare/$target_branch...$head"
}

function ghc {
  local commit_sha remote url
  commit_sha=$(git rev-parse "$1")
  if [ "$#" -eq 1 ]; then
    remote=origin
  else
    remote="$2"
  fi
  url=$(get_git_url "$remote")
  [ -n "$url" ] && open_url "https://$url/commit/$commit_sha"
}
