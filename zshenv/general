#!/usr/bin/env zsh

export EDITOR='vim'
export TERM='xterm-256color'

if [ "$(uname)" = 'Darwin' ]; then
  OS='mac'
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
else
  OS="$(cat /etc/os-release | grep '^ID=' | cut --delimiter='=' --fields=2)"
fi

export OS

export KUBECONFIG="$(printf '%s:' ~/.kube/config/*(N) | sed 's/:$//')"
